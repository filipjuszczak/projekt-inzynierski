// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

enum UserType {
  NORMAL
  EMPLOYEE
  ADMIN
}

model User {
  id           String    @id
  username     String?   @unique
  firstName    String
  lastName     String
  email        String    @unique
  dateOfBirth  DateTime
  passwordHash String
  userType     UserType  @default(NORMAL)
  isActivated  Boolean   @default(false)
  sessions     Session[]
  seats        Seat[]
  orders       Order[]
  ratings      Rating[]
  tokens       Token[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  expiresAt DateTime

  @@map("sessions")
}

enum TokenType {
  ACTIVATION
  PASSWORD_RESET
}

model Token {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  value     String
  isActive  Boolean   @default(true)
  expiresAt DateTime
  User      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("tokens")
}

enum ShowtimeStatus {
  UPCOMING
  ONGOING
  FINISHED
}

model Showtime {
  id        String         @id @default(cuid())
  movie     Movie          @relation(fields: [movieId], references: [id])
  movieId   String
  room      Room           @relation(fields: [roomId], references: [id])
  roomId    String
  startTime DateTime
  endTime   DateTime
  status    ShowtimeStatus
  createdBy String
  updatedBy String?
  seats     Seat[]
  orders    Order[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("showtimes")
}

model Movie {
  id          String           @id @default(cuid())
  title       String
  description String
  releaseYear Int
  duration    Int
  posterUrl   String?
  createdBy   String
  updatedBy   String?
  genres      GenresOnMovies[]
  showtimes   Showtime[]
  ratings     Rating[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("movies")
}

model Genre {
  id             String           @id @default(cuid())
  name           String           @unique
  ageRestriction Int
  createdBy      String
  updatedBy      String?
  movies         GenresOnMovies[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("genres")
}

model GenresOnMovies {
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId String

  @@id([movieId, genreId])
  @@map("genres_on_movies")
}

model Room {
  id           String     @id @default(cuid())
  number       Int
  numberOfRows Int
  seatsPerRow  Int
  showtimes    Showtime[]
  seats        Seat[]
  createdBy    String
  updatedBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("rooms")
}

enum TicketType {
  NORMAL
  REDUCED
}

model Ticket {
  id         String     @id @default(cuid())
  ticketType TicketType
  price      Float
  orders     Order[]
  createdBy  String
  updatedBy  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("tickets")
}

model Order {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  showtimeId String
  showtime   Showtime @relation(fields: [showtimeId], references: [id])
  seatId     String
  seat       Seat     @relation(fields: [seatId], references: [id])
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("orders")
}

model Seat {
  id         String   @id @default(cuid())
  rowNumber  Int
  seatNumber Int
  isBooked   Boolean  @default(false)
  showtimeId String
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([showtimeId, rowNumber, seatNumber])
  @@map("seats")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id])
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, movieId])
  @@map("ratings")
}
