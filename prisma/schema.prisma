generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

enum Role {
  NORMAL
  EMPLOYEE
  ADMIN
}

model User {
  id                 String    @id @default(uuid())
  username           String?   @unique
  firstName          String
  lastName           String
  email              String    @unique
  dateOfBirth        DateTime
  passwordHash       String
  role               Role      @default(NORMAL)
  isActivated        Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  sessions           Session[]
  seats              Seat[]
  orders             Order[]
  tokens             Token[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  expiresAt DateTime

  @@map("sessions")
}

enum TokenType {
  ACTIVATION
  PASSWORD_RESET
}

model Token {
  id        String    @id @default(uuid())
  userId    String
  type      TokenType
  value     String
  isActive  Boolean   @default(true)
  expiresAt DateTime
  User      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("tokens")
}

enum ShowtimeStatus {
  UPCOMING
  ONGOING
  FINISHED
}

model Showtime {
  id        String         @id @default(uuid())
  movie     Movie          @relation(fields: [movieId], references: [id])
  movieId   String
  room      Room           @relation(fields: [roomId], references: [id])
  roomId    String
  startTime DateTime
  endTime   DateTime
  status    ShowtimeStatus
  createdBy String
  updatedBy String?
  seats     Seat[]
  orders    Order[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("showtimes")
}

model Movie {
  id          String           @id @default(uuid())
  title       String
  description String
  releaseDate DateTime
  duration    Int
  posterUrl   String?
  createdBy   String
  updatedBy   String?
  genres      GenresOnMovies[]
  showtimes   Showtime[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("movies")
}

model Genre {
  id             String           @id @default(uuid())
  name           String           @unique
  ageRestriction Int
  createdBy      String
  updatedBy      String?
  movies         GenresOnMovies[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("genres")
}

model GenresOnMovies {
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId String

  @@id([movieId, genreId])
  @@map("genres_on_movies")
}

model Room {
  id           String     @id @default(uuid())
  number       String
  numberOfRows Int
  seatsPerRow  Int
  showtimes    Showtime[]
  seats        Seat[]
  createdBy    String
  updatedBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("rooms")
}

enum TicketType {
  NORMAL
  REDUCED
}

model Ticket {
  id         String     @id @default(uuid())
  ticketType TicketType
  price      Float
  orders     Order[]
  createdBy  String
  updatedBy  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("tickets")
}

model Order {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  showtimeId String
  showtime   Showtime @relation(fields: [showtimeId], references: [id])
  seatId     String
  seat       Seat     @relation(fields: [seatId], references: [id])
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("orders")
}

model Seat {
  id         String   @id @default(uuid())
  rowNumber  Int
  seatNumber Int
  isBooked   Boolean  @default(false)
  showtimeId String
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([showtimeId, rowNumber, seatNumber])
  @@map("seats")
}
