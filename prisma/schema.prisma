generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  NORMAL
  EMPLOYEE
  ADMIN
}

enum UserType {
  GUEST
  REGULAR
}

model User {
  id                        String         @id @default(uuid())
  type                      UserType       @default(REGULAR)
  username                  String?        @unique
  firstName                 String
  lastName                  String
  email                     String         @unique
  dateOfBirth               DateTime
  password                  String?
  role                      Role?          @default(NORMAL)
  isActivated               Boolean?       @default(false)
  mustChangePassword        Boolean?       @default(false)
  newsletterConsent         Boolean?       @default(false)
  unsuccessfulLoginAttempts Int?           @default(0)
  isLocked                  Boolean?       @default(false)
  sessions                  Session[]
  seats                     Seat[]
  orders                    Order[]
  tokens                    Token[]
  activities                UserActivity[]
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(references: [id], fields: [userId], onDelete: Cascade)
  expiresAt DateTime

  @@map("sessions")
}

enum TokenType {
  ACTIVATION
  PASSWORD_RESET
}

model Token {
  id        String    @id @default(uuid())
  userId    String
  type      TokenType
  value     String
  isActive  Boolean   @default(true)
  expiresAt DateTime
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("tokens")
}

enum ScreenFormat {
  TWO_D
  THREE_D
  IMAX
}

enum ViewingMode {
  SUBTITLES
  DUBBING
}

enum ShowtimeStatus {
  UPCOMING
  ONGOING
  FINISHED
}

model Showtime {
  id               String            @id @default(uuid())
  movie            Movie             @relation(fields: [movieId], references: [id])
  movieId          String
  room             Room              @relation(fields: [roomId], references: [id])
  roomId           String
  startTime        DateTime
  endTime          DateTime
  status           ShowtimeStatus
  screenFormat     ScreenFormat
  viewingMode      ViewingMode
  seatReservations SeatReservation[]
  seats            Seat[]
  orders           Order[]
  createdBy        String
  updatedBy        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("showtimes")
}

model MovieViewingMode {
  id          Int         @id @default(autoincrement())
  movieId     String
  viewingMode ViewingMode
  movie       Movie       @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([movieId, viewingMode])
  @@map("viewing_modes_on_movies")
}

model MovieScreenFormat {
  id           Int          @id @default(autoincrement())
  movieId      String
  screenFormat ScreenFormat
  movie        Movie        @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@unique([movieId, screenFormat])
  @@map("screen_formats_on_movies")
}

model Movie {
  id               String              @id @default(uuid())
  title            String              @unique
  description      String
  shortDescription String
  releaseDate      DateTime
  duration         Int
  posterUrl        String?
  isFeatured       Boolean             @default(false)
  screenFormats    MovieScreenFormat[]
  viewingModes     MovieViewingMode[]
  genres           GenresOnMovies[]
  showtimes        Showtime[]
  createdBy        String
  updatedBy        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@map("movies")
}

model Genre {
  id             String           @id @default(uuid())
  name           String           @unique
  ageRestriction Int
  createdBy      String
  updatedBy      String?
  movies         GenresOnMovies[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("genres")
}

model GenresOnMovies {
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId String

  @@id([movieId, genreId])
  @@map("genres_on_movies")
}

model Room {
  id           String     @id @default(uuid())
  number       String
  numberOfRows Int
  seatsPerRow  Int
  showtimes    Showtime[]
  seats        Seat[]
  createdBy    String
  updatedBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("rooms")
}

enum TicketType {
  NORMAL
  REDUCED
}

model TicketInfo {
  id      String     @id @default(uuid())
  type    TicketType @unique
  price   Int
  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tickets_info")
}

model Ticket {
  id           Int         @id @default(autoincrement())
  type         String
  price        Float
  ticketInfoId String?
  ticketInfo   TicketInfo? @relation(fields: [ticketInfoId], references: [id])
  orderId      String?
  order        Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tickets")
}

enum OrderType {
  RESERVATION
  PAID
}

model Order {
  id         String    @id @default(uuid())
  type       OrderType
  isPaid     Boolean?
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  showtimeId String
  showtime   Showtime  @relation(fields: [showtimeId], references: [id])
  seats      Seat[]    @relation("OrderSeats")
  tickets    Ticket[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  ticketId   String?

  @@map("orders")
}

model Seat {
  id         String   @id @default(uuid())
  rowNumber  Int
  seatNumber Int
  showtimeId String
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?   @relation("OrderSeats", fields: [orderId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([showtimeId, rowNumber, seatNumber])
  @@map("seats")
}

model SeatReservation {
  id         String   @id
  showtimeId String
  showtime   Showtime @relation(fields: [showtimeId], references: [id])
  sessionId  String
  rowNumber  Int
  seatNumber Int
  createdAt  DateTime @default(now())

  @@map("seat_reservations")
}

enum UserActivities {
  ACTIVATED_ACCOUNT
  DELETED_ACCOUNT
  PASSWORD_CHANGED
  REQUESTED_PASSWORD_RESET
  DATA_CHANGED
  NEWSLETTER_CONSENT_GRANTED
  NEWSLETTER_CONSENT_REVOKED
  CREATED_RESERVATION
}

model UserActivity {
  id        String         @id @default(uuid())
  type      UserActivities
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())

  @@map("users_activities")
}
